---
import type { Page } from '../lib/content';
interface Props { page: Page }
const { page } = Astro.props;
// Main search term: the title without its abbreviation in brackets.
const abbrev = (page.title.match(/\(([^)]+)\)/) || [])[1] || '';
const term = page.researchTerm || page.title.replace(/\s*\([^)]*\)\s*/g, ' ').replace(/^(Approach to|Management of)\s+/i, '').replace(/\s+/g, ' ').trim();
const extra = [abbrev, ...page.aliases.filter(a => a.length > 2 && !/\s{2}/.test(a))].filter(Boolean).slice(0, 3);
---
<aside class="research" id="research" aria-label="Research sidebar" data-term={term} data-extra={JSON.stringify(extra)}>
  <h2><span aria-hidden="true">🔬</span> Fresh research</h2>
  <p class="sub-t">Live results for this topic from PubMed, Europe PMC and Wikipedia.</p>
  <form class="r-query" id="r-form">
    <input id="r-q" type="search" value={term} aria-label="Research search terms" />
    <button type="submit">Go</button>
  </form>
  <div class="r-tabs" role="tablist">
    <button role="tab" aria-selected="true" data-tab="articles">Articles</button>
    <button role="tab" aria-selected="false" data-tab="free">Free text</button>
    <button role="tab" aria-selected="false" data-tab="books">Chapters</button>
    <button role="tab" aria-selected="false" data-tab="fun">Explore</button>
  </div>
  <div class="r-filters" id="r-filters" data-for="articles">
    <button aria-pressed="true" data-ptype="">All</button>
    <button aria-pressed="false" data-ptype="review">Reviews</button>
    <button aria-pressed="false" data-ptype="guideline">Guidelines</button>
    <button aria-pressed="false" data-ptype="trial">Trials</button>
    <button aria-pressed="false" data-years="1" title="Only the last 12 months">Past year</button>
  </div>
  <ul class="r-list" id="r-list" aria-live="polite"></ul>
  <p class="r-foot">Results come straight from public databases and are not reviewed by NPPR. Check against the guidelines on this page.</p>
</aside>
<button class="panel-toggle" id="panel-toggle" aria-controls="research" aria-expanded="false"><span aria-hidden="true">🔬</span> Research</button>
