---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<div class="palette" id="palette" role="dialog" aria-modal="true" aria-label="Search" data-index={`${base}search.json`}>
  <div class="palette-box">
    <div class="palette-input">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="palette-q" type="search" placeholder="Search topics, guidelines, drugs…" autocomplete="off" aria-label="Search" />
    </div>
    <ul class="palette-results" id="palette-results"></ul>
    <div class="palette-foot"><span>↑↓ to move</span><span>↵ to open</span><span>Esc to close</span></div>
  </div>
</div>
