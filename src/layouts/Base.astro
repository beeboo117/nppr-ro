---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { loadSite, getRegions } from '../lib/content';
import SideNav from '../components/SideNav.astro';
import Palette from '../components/Palette.astro';
import { BRAND } from '../lib/brand';

interface Props { title: string; description?: string; currentId?: string; section?: string; panel?: boolean; nav?: boolean }
const { title, description = `${BRAND.name}: an interactive index of current primary care guidelines ${BRAND.tagline}, built on NPPR.ca.`, currentId, section, panel = false, nav = true } = Astro.props;
const { sections } = loadSite();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const regions = getRegions().filter(r => (r.live || r.code === 'AB') && r.code.length === 2 && r.code !== 'CA');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title === 'Home' ? BRAND.name : `${title} · ${BRAND.short}`}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>
    document.documentElement.classList.add('js');
    try { const t = localStorage.getItem('nppr-theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    try { document.documentElement.dataset.aud = JSON.parse(localStorage.getItem('nppr-aud') || '"md"') === 'np' ? 'np' : 'md'; } catch { document.documentElement.dataset.aud = 'md'; }
  </script>
  <ClientRouter />
</head>
<body data-base={base}>
  <div class="progress" id="progress" aria-hidden="true"></div>
  <header class="site-header">
    {nav && <button class="icon-btn menu-btn" id="menu-btn" aria-label="Open menu" aria-controls="side-nav" aria-expanded="false">☰</button>}
    <a class="brand" href={base}>
      <span class="brand-mark" aria-hidden="true">{BRAND.mark}</span>
      <span><span class="brand-long">{BRAND.name}</span><span class="brand-short">{BRAND.short}</span><small>Primary care guidelines {BRAND.tagline}</small></span>
    </a>
    <nav class="tabs" aria-label="Sections">
      {sections.filter(s => s.slug !== 'about').map(s => (
        <a class="tab" href={s.index?.href ?? base} aria-current={s.slug === section ? 'true' : undefined}>{s.title}</a>
      ))}
    </nav>
    <div class="hdr-actions">
      <button class="search-btn" id="search-btn" aria-label="Search (Ctrl+K)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="lbl">Search</span><kbd>Ctrl K</kbd>
      </button>
      <select class="region aud" id="aud" aria-label="Show resources for" title="Show resources for physicians or nurse practitioners">
        <option value="md">MD/DO</option>
        <option value="np">NP</option>
      </select>
      <select class="region" id="region" aria-label="Your province">
        {regions.map(r => <option value={r.code} title={r.name}>{r.code}</option>)}
      </select>
      <button class="icon-btn" id="theme-btn" aria-label="Switch light or dark theme"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></button>
    </div>
  </header>

  <div class={`shell${panel ? ' has-panel' : ''}${nav ? '' : ' no-nav'}`}>
    {nav && <SideNav currentId={currentId} currentSection={section} />}
    <main id="main" transition:name="main-content">
      <slot />
    </main>
    <slot name="panel" />
  </div>
  <div class="scrim" id="scrim"></div>

  <footer class="site-footer">
    <p>Content from <a href="https://www.nppr.ca" target="_blank" rel="noopener">NPPR.ca</a> by Joe Grafe and contributors, used under <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>. Redesigned layout, dashboard and research sidebar are RoPro's.</p>
    <p>Linked guidelines belong to their publishers. Not clinical advice. <a href={`${base}credits/`}>Credits and sources</a></p>
  </footer>
  <Palette />
  <script>
    import { boot } from '../scripts/app';
    document.addEventListener('astro:page-load', boot);
  </script>
</body>
</html>
